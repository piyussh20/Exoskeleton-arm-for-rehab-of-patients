// =====================================================
// POWER-ASSISTED EXOSKELETON  (FIXED VERSION)
// Teensy 4.1
//
// ELBOW:
//   EMG        -> Pin 14 (A0)
//   ICM-20948  -> SDA 18, SCL 19
//   BTS7960    -> Pins 5 (RPWM), 6 (LPWM), 7 (R_EN), 8 (L_EN)
//
// SHOULDER:
//   EMG        -> Pin 15 (A1)
//   BTS7960    -> Pins 28 (RPWM), 29 (LPWM), 30 (R_EN), 31 (L_EN)
//   Switch     -> Pin 32 (HIGH = forward, LOW = backward)
//
// Motor: 12 V, 329 N/cm
//
// FIXES:
//   1. BOTH R_EN and L_EN are now HIGH while driving
//   2. MIN_PWM added so the motor overcomes stiction
//   3. IMU init at address 0x69 (falls back to 0x68), with error check
//   4. pitch is static (keeps last value)
//   5. IMU read at 100 Hz, serial print at 10 Hz
//   6. Elbow motor is stopped if the IMU is not detected (safety)
// =====================================================

#include <Wire.h>
#include <ICM_20948.h>

// =====================================================
// ICM-20948
// =====================================================

ICM_20948_I2C myICM;
bool imuReady = false;

// =====================================================
// PINS
// =====================================================

const int ELBOW_EMG_PIN = 14;      // A0
const int SHOULDER_EMG_PIN = 15;   // A1

const int ELBOW_RPWM = 5;
const int ELBOW_LPWM = 6;
const int ELBOW_REN  = 7;
const int ELBOW_LEN  = 8;

const int SHOULDER_RPWM = 28;
const int SHOULDER_LPWM = 29;
const int SHOULDER_REN  = 30;
const int SHOULDER_LEN  = 31;

const int SHOULDER_SWITCH = 32;

// =====================================================
// EMG SETTINGS
// =====================================================

const int SAMPLE_RATE = 1000;
const int BASELINE_SAMPLES = 1000;
const int ENVELOPE_WINDOW = 50;

int elbowThreshold = 180;
int shoulderThreshold = 180;

// =====================================================
// MOTOR PWM
// =====================================================

const int MIN_PWM = 30;   // raise until the motor just starts moving
const int MAX_PWM = 80;   // raise temporarily (e.g. 150) to test if motor still won't move

// =====================================================
// EMG VARIABLES
// =====================================================

int elbowBaseline = 0;
int elbowEnvelopeBuffer[ENVELOPE_WINDOW];
long elbowEnvelopeSum = 0;
int elbowBufferIndex = 0;

int shoulderBaseline = 0;
int shoulderEnvelopeBuffer[ENVELOPE_WINDOW];
long shoulderEnvelopeSum = 0;
int shoulderBufferIndex = 0;

// =====================================================
// ELBOW DIRECTION
// =====================================================

enum ElbowDirection
{
  ELBOW_FORWARD,
  ELBOW_BACKWARD
};

ElbowDirection elbowDirection = ELBOW_FORWARD;

// Pitch limits (watch the "Pitch" value in Serial Monitor and adjust)
const float ELBOW_CONTRACTION_LIMIT = -7.0;   // pitch <= this -> BACKWARD
const float ELBOW_EXTENSION_LIMIT   = 40.0;   // pitch >= this -> FORWARD

// =====================================================
// TIMING
// =====================================================

unsigned long nextSampleTime;
unsigned long lastImuRead = 0;
unsigned long lastPrint = 0;

float pitch = 0.0;

// =====================================================
// MOTOR FUNCTIONS
// =====================================================

void stopElbow()
{
  analogWrite(ELBOW_RPWM, 0);
  analogWrite(ELBOW_LPWM, 0);
  digitalWrite(ELBOW_REN, LOW);
  digitalWrite(ELBOW_LEN, LOW);
}

void stopShoulder()
{
  analogWrite(SHOULDER_RPWM, 0);
  analogWrite(SHOULDER_LPWM, 0);
  digitalWrite(SHOULDER_REN, LOW);
  digitalWrite(SHOULDER_LEN, LOW);
}

void moveElbowForward(int pwm)
{
  digitalWrite(ELBOW_REN, HIGH);
  digitalWrite(ELBOW_LEN, HIGH);
  analogWrite(ELBOW_LPWM, 0);
  analogWrite(ELBOW_RPWM, pwm);
}

void moveElbowBackward(int pwm)
{
  digitalWrite(ELBOW_REN, HIGH);
  digitalWrite(ELBOW_LEN, HIGH);
  analogWrite(ELBOW_RPWM, 0);
  analogWrite(ELBOW_LPWM, pwm);
}

void moveShoulderForward(int pwm)
{
  digitalWrite(SHOULDER_REN, HIGH);
  digitalWrite(SHOULDER_LEN, HIGH);
  analogWrite(SHOULDER_LPWM, 0);
  analogWrite(SHOULDER_RPWM, pwm);
}

void moveShoulderBackward(int pwm)
{
  digitalWrite(SHOULDER_REN, HIGH);
  digitalWrite(SHOULDER_LEN, HIGH);
  analogWrite(SHOULDER_RPWM, 0);
  analogWrite(SHOULDER_LPWM, pwm);
}

// =====================================================
// IMU INIT (tries 0x69 then 0x68)
// =====================================================

bool initIMU()
{
  for (int attempt = 0; attempt < 6; attempt++)
  {
    uint8_t ad0 = (attempt % 2 == 0) ? 1 : 0;   // 1 = 0x69, 0 = 0x68

    myICM.begin(Wire, ad0);

    Serial.print("IMU init (AD0=");
    Serial.print(ad0);
    Serial.print("): ");
    Serial.println(myICM.statusString());

    if (myICM.status == ICM_20948_Stat_Ok)
    {
      return true;
    }

    delay(300);
  }

  return false;
}

// =====================================================
// SETUP
// =====================================================

void setup()
{
  Serial.begin(115200);
  delay(500);

  analogReadResolution(12);
  analogReadAveraging(1);

  pinMode(ELBOW_RPWM, OUTPUT);
  pinMode(ELBOW_LPWM, OUTPUT);
  pinMode(ELBOW_REN, OUTPUT);
  pinMode(ELBOW_LEN, OUTPUT);

  pinMode(SHOULDER_RPWM, OUTPUT);
  pinMode(SHOULDER_LPWM, OUTPUT);
  pinMode(SHOULDER_REN, OUTPUT);
  pinMode(SHOULDER_LEN, OUTPUT);

  pinMode(SHOULDER_SWITCH, INPUT_PULLDOWN);

  // 20 kHz PWM (quiet, within BTS7960 limit)
  analogWriteFrequency(ELBOW_RPWM, 20000);
  analogWriteFrequency(ELBOW_LPWM, 20000);
  analogWriteFrequency(SHOULDER_RPWM, 20000);
  analogWriteFrequency(SHOULDER_LPWM, 20000);

  stopElbow();
  stopShoulder();

  // ---------------- IMU ----------------
  Wire.begin();
  Wire.setClock(400000);

  imuReady = initIMU();

  if (imuReady)
  {
    Serial.println("IMU READY");
  }
  else
  {
    Serial.println("IMU NOT FOUND - elbow motor disabled. Check wiring / run I2C scanner.");
  }

  delay(1000);

  // ---------------- EMG BASELINES (keep muscles relaxed) ----------------
  Serial.println("Calibrating EMG baseline - relax your muscles...");

  long elbowSum = 0;
  for (int i = 0; i < BASELINE_SAMPLES; i++)
  {
    elbowSum += analogRead(ELBOW_EMG_PIN);
    delay(1);
  }
  elbowBaseline = elbowSum / BASELINE_SAMPLES;

  long shoulderSum = 0;
  for (int i = 0; i < BASELINE_SAMPLES; i++)
  {
    shoulderSum += analogRead(SHOULDER_EMG_PIN);
    delay(1);
  }
  shoulderBaseline = shoulderSum / BASELINE_SAMPLES;

  for (int i = 0; i < ENVELOPE_WINDOW; i++)
  {
    elbowEnvelopeBuffer[i] = 0;
    shoulderEnvelopeBuffer[i] = 0;
  }

  Serial.println("Calibration done.");

  nextSampleTime = micros();
}

// =====================================================
// LOOP
// =====================================================

void loop()
{
  unsigned long currentTime = micros();

  if ((long)(currentTime - nextSampleTime) >= 0)
  {
    nextSampleTime += 1000000UL / SAMPLE_RATE;

    // ---------------- ELBOW EMG ----------------
    int elbowRaw = analogRead(ELBOW_EMG_PIN);
    int elbowRectified = abs(elbowRaw - elbowBaseline);

    elbowEnvelopeSum -= elbowEnvelopeBuffer[elbowBufferIndex];
    elbowEnvelopeBuffer[elbowBufferIndex] = elbowRectified;
    elbowEnvelopeSum += elbowRectified;

    int elbowEnvelope = elbowEnvelopeSum / ENVELOPE_WINDOW;

    // ---------------- SHOULDER EMG ----------------
    int shoulderRaw = analogRead(SHOULDER_EMG_PIN);
    int shoulderRectified = abs(shoulderRaw - shoulderBaseline);

    shoulderEnvelopeSum -= shoulderEnvelopeBuffer[shoulderBufferIndex];
    shoulderEnvelopeBuffer[shoulderBufferIndex] = shoulderRectified;
    shoulderEnvelopeSum += shoulderRectified;

    int shoulderEnvelope = shoulderEnvelopeSum / ENVELOPE_WINDOW;

    // ---------------- IMU (100 Hz) ----------------
    if (imuReady && (millis() - lastImuRead >= 10))
    {
      lastImuRead = millis();

      if (myICM.dataReady())
      {
        myICM.getAGMT();

        float ax = myICM.accX();
        float ay = myICM.accY();
        float az = myICM.accZ();

        pitch = atan2(ax, sqrt((ay * ay) + (az * az))) * 180.0 / PI;
      }
    }

    // ---------------- ELBOW DIRECTION ----------------
    if (pitch <= ELBOW_CONTRACTION_LIMIT)
    {
      elbowDirection = ELBOW_BACKWARD;
    }

    if (pitch >= ELBOW_EXTENSION_LIMIT)
    {
      elbowDirection = ELBOW_FORWARD;
    }

    // ---------------- ELBOW MOTOR ----------------
    if (imuReady && elbowEnvelope >= elbowThreshold)
    {
      int elbowPWM = map(elbowEnvelope, elbowThreshold, 500, MIN_PWM, MAX_PWM);
      elbowPWM = constrain(elbowPWM, MIN_PWM, MAX_PWM);

      if (elbowDirection == ELBOW_FORWARD)
      {
        moveElbowForward(elbowPWM);
      }
      else
      {
        moveElbowBackward(elbowPWM);
      }
    }
    else
    {
      stopElbow();
    }

    // ---------------- SHOULDER SWITCH ----------------
    int shoulderDirection = digitalRead(SHOULDER_SWITCH);

    // ---------------- SHOULDER MOTOR ----------------
    if (shoulderEnvelope >= shoulderThreshold)
    {
      int shoulderPWM = map(shoulderEnvelope, shoulderThreshold, 500, MIN_PWM, MAX_PWM);
      shoulderPWM = constrain(shoulderPWM, MIN_PWM, MAX_PWM);

      if (shoulderDirection == HIGH)
      {
        moveShoulderForward(shoulderPWM);
      }
      else
      {
        moveShoulderBackward(shoulderPWM);
      }
    }
    else
    {
      stopShoulder();
    }

    // ---------------- BUFFER INDEXES ----------------
    elbowBufferIndex++;
    if (elbowBufferIndex >= ENVELOPE_WINDOW) elbowBufferIndex = 0;

    shoulderBufferIndex++;
    if (shoulderBufferIndex >= ENVELOPE_WINDOW) shoulderBufferIndex = 0;

    // ---------------- SERIAL STATUS (10 Hz) ----------------
    if (millis() - lastPrint >= 100)
    {
      lastPrint = millis();

      Serial.print("Pitch: ");
      Serial.print(pitch, 1);

      Serial.print(" | ElbowEMG: ");
      Serial.print(elbowEnvelope);

      Serial.print(" | ShoulderEMG: ");
      Serial.print(shoulderEnvelope);

      Serial.print(" | Elbow: ");
      if (elbowEnvelope < elbowThreshold)       Serial.print("REST");
      else if (elbowDirection == ELBOW_FORWARD) Serial.print("FORWARD");
      else                                      Serial.print("BACKWARD");

      Serial.print(" | Shoulder: ");
      if (shoulderEnvelope < shoulderThreshold) Serial.println("REST");
      else if (shoulderDirection == HIGH)       Serial.println("FORWARD");
      else                                      Serial.println("BACKWARD");
    }
  }
}
